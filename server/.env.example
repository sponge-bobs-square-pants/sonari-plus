# ── MongoDB ──────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/sonari

# ── Auth ─────────────────────────────────────────
# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ── Server ───────────────────────────────────────
# Note: avoid 5000 on macOS — the AirPlay Receiver occupies it.
PORT=5174
NODE_ENV=development

# Frontend origin allowed by CORS (must match the Vite dev URL)
CLIENT_URL=http://localhost:5173

# ── First admin (used once by `npm run seed:admin`) ──
ADMIN_NAME=Sonari Admin
ADMIN_EMAIL=admin@sonari.com
ADMIN_PASSWORD=change-this-password

# ── Cloudinary (product image uploads) ──────────────
# From the Cloudinary dashboard. The secret is sensitive — keep it
# only here, never in client code or version control.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
