# ── MongoDB ──────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/sonari

# ── Auth ─────────────────────────────────────────
# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ── Server ───────────────────────────────────────
# Note: avoid 5000 on macOS — the AirPlay Receiver occupies it.
PORT=5174
NODE_ENV=development

# Frontend origin(s) allowed by CORS — comma-separated. Dev = the Vite URL;
# prod = the storefront origin(s), e.g. https://www.nuit.in,https://nuit.in
CLIENT_URL=http://localhost:5173

# ── First admin (used once by `npm run seed:admin`) ──
ADMIN_NAME=Sonari Admin
ADMIN_EMAIL=admin@sonari.com
ADMIN_PASSWORD=change-this-password

# ── Cloudinary (product image uploads) ──────────────
# From the Cloudinary dashboard. The secret is sensitive — keep it
# only here, never in client code or version control.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Delhivery (courier — dispatch + tracking) ───────
# config/delhivery.js switches by NODE_ENV: dev key + staging-express,
# prod key + track.delhivery.com. See DELHIVERY.md for the integration.
DELHIVERY_DEV_API_KEY=your-staging-token
DELHIVERY_PROD_API_KEY=your-production-token
# The account's client name — the `cl` param on the waybill API.
DELHIVERY_CLIENT_ID=your-client-name
# Registered pickup warehouse name — MUST match Delhivery exactly.
DELHIVERY_PICKUP_WAREHOUSE=SONARI NIGHT WEAR
# Scan Push webhook secret — a value WE invent and declare in Delhivery's
# webhook requirement doc; Delhivery sends it as the `x-delhivery-token`
# header on every scan POST so /api/orders/delhivery-webhook can verify it.
DELHIVERY_DEV_WEBHOOK_TOKEN=invent-a-long-random-string
DELHIVERY_PROD_WEBHOOK_TOKEN=invent-a-long-random-string
# Optional hardening: restrict the webhook to Delhivery's source IPs at the
# nginx/firewall layer (not in code). Dev: 18.136.12.154 13.250.167.49
# 52.220.126.238 3.108.106.65 3.109.19.228 3.7.116.186 3.6.106.39 ·
# Prod: 13.229.195.68 18.139.238.62 52.76.70.1 3.108.106.65 13.127.20.101
# 13.126.12.240 35.154.161.83 3.6.106.39 18.61.175.16
